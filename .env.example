# -----------------------------------------------------------------------------
# Contribo environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# The app installs, builds and runs without any of these; features that need a
# missing value show a "not configured" state instead.
# -----------------------------------------------------------------------------

# Public URL of the app (used for metadata and OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Auth + PostgreSQL) --------------------------------------------
# Project Settings → API in the Supabase dashboard.
# Use the publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret key (sb_secret_... or legacy service_role key).
# Required for: repository and pull-request verification, policy publishing,
# wallet linking and onchain reconciliation. It bypasses Row Level Security and
# is only used in server code after authorization. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- GitHub OAuth -------------------------------------------------------------
# GitHub sign-in is handled by Supabase Auth. Create a GitHub OAuth App with the
# callback URL https://<project-ref>.supabase.co/auth/v1/callback and paste its
# Client ID / Secret into Supabase → Authentication → Sign In / Providers → GitHub.
# These variables are only read by the Supabase CLI when running Supabase locally
# (see README → "Local Supabase").
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-oauth-client-secret

# --- GitHub API (server-only, optional) ---------------------------------------
# Token used by the server to read public repositories, pull requests and the
# repository verification file. Optional: without it GitHub allows only 60
# requests/hour per server IP. A fine-grained token with no extra permissions
# (public repositories, read-only) is enough. NEVER prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=

# --- Monad --------------------------------------------------------------------
# Network the wallet connects to: "testnet" (chain 10143, default) or "mainnet" (chain 143).
NEXT_PUBLIC_MONAD_NETWORK=testnet

# Optional dedicated RPC endpoint. Leave empty to use the public Monad RPC.
NEXT_PUBLIC_MONAD_RPC_URL=

# --- Wallet connect modal (RainbowKit) ----------------------------------------
# Optional WalletConnect / Reown project ID (free at https://cloud.reown.com).
# Enables phone wallets via QR code. Without it, browser-extension wallets work
# and the modal links to wallet downloads.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed ContriboRewards contract on the network above. Leave empty to turn
# onchain features off ("not configured", no transactions offered).
# Monad Testnet deployment: 0xf2080fC3CDBeFa5577b5c185794dBfAB348DD5D3
NEXT_PUBLIC_CONTRIBO_REWARDS_ADDRESS=
